# Copy to .env.local and fill in. Never commit .env.local.

# Google AI Studio -> Get API key
GEMINI_API_KEY=

# Supabase dashboard -> Project Settings -> API
# Project URL
SUPABASE_URL=
# Secret key (sb_secret_...) or the legacy service_role key. Server-only: never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Optional: time zone used when showing dates (default Asia/Kolkata)
# NEXT_PUBLIC_TIME_ZONE=Asia/Kolkata

# Optional: require this password to open the site (set it on Vercel until agent logins exist)
# SITE_PASSWORD=
