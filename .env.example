# Copy to .env.local and fill in. Never commit .env.local.

# Google AI Studio -> Get API key
GEMINI_API_KEY=

# Supabase dashboard -> Project Settings -> API
# Project URL
SUPABASE_URL=
# Secret key (sb_secret_...) or the legacy service_role key. Server-only: never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Optional: time zone used when showing dates (default Asia/Kolkata)
# NEXT_PUBLIC_TIME_ZONE=Asia/Kolkata

# Optional: send email replies through Resend (resend.com). Without these, replies are saved but not emailed.
# RESEND_API_KEY=...
# A sender on a domain you verified in Resend, e.g. support@yourcompany.com
# EMAIL_FROM=...
# Optional: where customer replies should go, e.g. your inbound address at Postmark
# EMAIL_REPLY_TO=...

# Optional: email server errors from the live site to this address (needs RESEND_API_KEY and EMAIL_FROM).
# Every error is also saved to the error_events table in Supabase either way.
# ALERT_EMAIL=...
